	<textbox id="password" editable="false" pos="0, 10" size="200,30"></textbox>

	<button pos="0, 50" size="50,50" onclick="add_char('1')">1</button>
	<button pos="50, 50" size="50,50" onclick="add_char('2')">2</button>
	<button pos="100, 50" size="50,50" onclick="add_char('3')">3</button>
	<button pos="150, 50" size="50,50" onclick="add_char('0')">0</button>
	
	<button pos="0, 100" size="50,50" onclick="add_char('4')">4</button>
	<button pos="50, 100" size="50,50" onclick="add_char('5')">5</button>
	<button pos="100, 100" size="50,50" onclick="add_char('6')">6</button>
	<button pos="150, 100" size="50,50" color="#00aa00" hover-color="#008800" onclick="check_password()">OK</button>

	<button pos="0, 150" size="50,50" onclick="add_char('7')">7</button>
	<button pos="50, 150" size="50,50" onclick="add_char('8')">8</button>
	<button pos="100, 150" size="50,50" onclick="add_char('9')">9</button>
	<button pos="150, 150" size="50,50" color="#aa0000" hover-color="#880000" onclick="clear_password()">CLEAR</button>
</container>
